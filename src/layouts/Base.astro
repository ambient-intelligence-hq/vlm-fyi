---
import "../styles/global.css";
import { updated } from "../lib/data";
import { REPO, AMBIENT_REPO, CONTACT, ambient } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}
const { title, description = "Measured request limits for vision-language model APIs: how many images and frames, how many bytes, and how big a video each provider accepts in one request." } = Astro.props;
const fullTitle = title ? `${title} · vlm.fyi` : "vlm.fyi: what vision model APIs actually accept";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  ["/", "Overview"],
  ["/#limits", "Compare"],
  ["/calculator", "Calculator"],
  ["/models", "Models"],
  ["/providers", "Providers"],
  ["/table", "Table"],
  ["/changes", "Changes"],
  ["/methodology", "Methodology"],
];
// In-page links (the homepage's limits explorer) never mark a page as current.
const isCurrent = (href: string) => (href === "/" ? path === "/" : !href.includes("#") && path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    {import.meta.env.PROD && (
      <>
        <!-- Google tag (gtag.js); production builds only, so local dev isn't counted -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VXR94EJN57"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-VXR94EJN57');
        </script>
      </>
    )}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f2ee" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#08090a" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="vlm.fyi changes" href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply the saved theme before first paint (no flash). "system" = follow the OS.
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/">vlm<i>.</i>fyi</a>
        <a class="by" href={ambient("header")} title="Ambient, the open-source video engine for AI agents">
          by
          <svg viewBox="0 0 192 192" fill="currentColor" aria-hidden="true"><circle cx="96" cy="44" r="10"/><path d="M89 58 24 152 70 144Z"/><path d="m103 58 18 86 47 8Z"/></svg>
          Ambient
        </a>
        <nav aria-label="Main">
          {nav.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>)}
        </nav>
        <a class="pill" href="/api">Get the data</a>
        <button class="theme" type="button" id="theme" data-mode="system" aria-label="Theme: system" title="Theme: system">
          <svg class="i-system" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="1.75" y="2.75" width="12.5" height="8.5" rx="1.5"/><path d="M5.5 13.75h5M8 11.25v2.5"/></svg>
          <svg class="i-light" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.25M8 13.25v1.25M1.5 8h1.25M13.25 8h1.25M3.4 3.4l.9.9M11.7 11.7l.9.9M3.4 12.6l.9-.9M11.7 4.3l.9-.9"/></svg>
          <svg class="i-dark" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1Z"/></svg>
        </button>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap foot">
        <div>
          <span class="brand">vlm<i>.</i>fyi</span>
          <p style="margin-top: 10px">
            Measured {updated} with synthetic probe requests. Limits change and can depend on your account.
          </p>
          <p style="margin-top: 10px">
            Built by <a href={ambient("footer")}>Ambient</a>, the open-source video engine for AI agents. We measure
            these limits because Ambient has to fit long videos into every one of them.
          </p>
        </div>
        <div>
          <h4>Explore</h4>
          {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        </div>
        <div>
          <h4>Data</h4>
          <a href="/v1/capabilities.json">JSON</a>
          <a href="/v1/capabilities.csv">CSV</a>
          <a href="/v1/changes.json">Changes JSON</a>
          <a href="/rss.xml">RSS</a>
        </div>
        <div>
          <h4>Project</h4>
          <a href={REPO}>Source</a>
          <a href={`mailto:${CONTACT}`}>Contact</a>
          <a href={ambient("footer-project")}>Ambient</a>
          <a href={AMBIENT_REPO}>Ambient on GitHub</a>
          <a href="https://creativecommons.org/licenses/by/4.0/">Data: CC BY 4.0</a>
          <a href="/api">API docs</a>
        </div>
        <div class="foot-contact">
          <h4>Corrections and contact</h4>
          <p>
            Found a limit that's wrong or out of date? <a href={`${REPO}/issues`}>Open an issue</a> with the request you
            sent and the error you got.
          </p>
          <p>
            For anything else, email <a href={`mailto:${CONTACT}`}>{CONTACT}</a>. Providers: if you'd like an endpoint
            measured, or think a number is unfair, tell us. Teams running video analysis at scale: we're happy to talk about
            what <a href={ambient("footer-contact")}>Ambient</a> can do for you.
          </p>
        </div>
      </div>
    </footer>
    <script>
      // On narrow screens the nav scrolls sideways: bring the current page's link into view.
      const nav = document.querySelector<HTMLElement>("header.site nav");
      const here = nav?.querySelector<HTMLElement>('[aria-current="page"]');
      if (nav && here && nav.scrollWidth > nav.clientWidth) nav.scrollLeft += here.getBoundingClientRect().left - nav.getBoundingClientRect().left - (nav.clientWidth - here.offsetWidth) / 2;
      // Cycle System → Light → Dark. "System" removes the override and follows the OS.
      const btn = document.getElementById("theme")!;
      const order = ["system", "light", "dark"] as const;
      type Mode = (typeof order)[number];
      const current = (): Mode => (document.documentElement.dataset.theme as Mode) || "system";
      const label = (m: Mode) => {
        btn.dataset.mode = m;
        const text = `Theme: ${m}. Click for ${order[(order.indexOf(m) + 1) % 3]}.`;
        btn.setAttribute("aria-label", text);
        btn.title = text;
      };
      label(current());
      btn.addEventListener("click", () => {
        const next = order[(order.indexOf(current()) + 1) % 3];
        if (next === "system") delete document.documentElement.dataset.theme;
        else document.documentElement.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        label(next);
      });
    </script>
  </body>
</html>
