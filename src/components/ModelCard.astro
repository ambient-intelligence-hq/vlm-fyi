---
// Small multiple: one model, a bar per provider, plus whether the provider takes video
// at all. Either frames per request on an axis shared by every card (`max`), or the
// overall score (0–100) that ranks the model's providers.
import { bars, providerLabel, providerSlug, cell, OVERALL, type Entry } from "../lib/data";
import ScoreInfo from "./ScoreInfo.astro";

interface Props {
  slug: string;
  name: string;
  vendor: string | null;
  entries: Entry[];
  max: number;
  metric?: "frames_768x432" | typeof OVERALL;
}
const { slug, name, vendor, entries, metric = "frames_768x432" } = Astro.props;
const score = metric === OVERALL;
const max = score ? 100 : Astro.props.max;
const all = bars(metric, entries);
// Providers without a value get one line under the bars, not a blank row each.
const rows = all.filter((r) => r.cls !== "na");
const untested = all.filter((r) => r.cls === "na");
const pct = (v: number) => `${Math.min(100, (v / max) * 100).toFixed(2)}%`;
const video = (e: Entry) => cell("video_file_bytes", e.limits.video_file_bytes, e);
const solo = score && entries.length === 1;
---
<article class="mc">
  <header>
    <h3><a href={`/models/${slug}`}>{name}</a></h3>
    <span class="sub">{vendor} · {entries.length} provider{entries.length > 1 ? "s" : ""}</span>
  </header>
  {solo && <p class="mc-solo sub">One provider, so nothing to rank. <a href={`/models/${slug}`}>See its limits</a>.</p>}
  <ul>
    {rows.map((r) => {
      const v = video(r.entry);
      return (
        <li data-tip-title={`${name} · ${providerLabel(r.entry)}`} data-tip-value={score ? `${r.text} / 100` : `${r.text} frames`} data-tip-body={r.tip} tabindex="0">
          <span class="mc-name">
            <a class="mc-prov" href={`/providers/${providerSlug(r.entry)}`} tabindex="-1">{providerLabel(r.entry)}</a>
            <span class:list={["mc-video", { no: v.cls.includes("unsupported") }]}>
              {v.cls.includes("unsupported") ? "No video" : v.text === "—" || v.text === "?" ? "Video: unknown" : v.text.startsWith("≥") ? `Video ${v.text}` : `Video up to ${v.text}`}
            </span>
          </span>
          <span class="mc-track">
            {r.value !== null && r.value > 0 && <span class:list={["mc-bar", { open: r.open }]} style={`width:${pct(r.value)}`}></span>}
          </span>
          <span class="mc-val">{r.text}</span>
        </li>
      );
    })}
  </ul>
  {rows.length > 0 && (
    <div class="mc-axis" aria-hidden={score ? undefined : "true"}>
      <span>0</span>
      {score ? <span>100 overall score<ScoreInfo /></span> : <span>{max.toLocaleString("en-US")} frames</span>}
    </div>
  )}
  {untested.length > 0 && !solo && (
    <details class="mc-untested">
      <summary>
        {rows.length ? `+ ${untested.length} more` : untested.length} provider{untested.length > 1 ? "s" : ""}
        {score ? " not scored: fewer than 2 limits measured" : " not tested yet"}
      </summary>
      <p>{untested.map((r, i) => <>{i > 0 && ", "}<a href={`/providers/${providerSlug(r.entry)}`}>{providerLabel(r.entry)}</a></>)}</p>
    </details>
  )}
</article>
