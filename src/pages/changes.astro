---
import Base from "../layouts/Base.astro";
import { changes, describeChange, groupBy } from "../lib/data";
const byDate = [...groupBy(changes, (c) => c.date).entries()];
---
<Base title="Changes" description="Every change to measured vision-model API limits, by date.">
  <div class="page-head">
  <span class="eyebrow">Changelog</span>
  <h1>Changes</h1>
  <p class="lede">Every time a limit changes between measurements, it shows up here. Subscribe with <a href="/rss.xml">RSS</a>.</p>
  </div>
  {byDate.length === 0 && <p class="empty">No changes recorded yet.</p>}
  {byDate.map(([date, cs]) => (
    <section>
      <h2>{new Date(`${date}T00:00:00Z`).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}</h2>
      {cs.every((c) => c.change === "added")
        ? <p>First measurement: {cs.length} model and provider pairs added.</p>
        : <ul class="plain">{cs.map((c) => <li>{describeChange(c)}</li>)}</ul>}
    </section>
  ))}
</Base>
