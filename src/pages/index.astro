---
import Base from "../layouts/Base.astro";
import RankedBars from "../components/RankedBars.astro";
import ModelCard from "../components/ModelCard.astro";
import CapabilityGrid from "../components/CapabilityGrid.astro";
import Tooltip from "../components/Tooltip.astro";
import MetricTabs from "../components/MetricTabs.astro";
import HeroChart from "../components/HeroChart.astro";
import VideoChart from "../components/VideoChart.astro";
import { entries, featured, METRICS, span, fmtNumber, models, providers, bars, niceScale, updated, modelSlug, HERO_MODEL, VIDEO_MODEL } from "../lib/data";

const plural = (n: number, one: string, many: string) => (new Intl.PluralRules("en-US").select(n) === "one" ? one : many);
const range = (key: string) => {
  const s = span(key);
  if (!s) return "—";
  const plus = s.hiOpen ? "+" : "";
  if (key.endsWith("_bytes")) {
    const mb = (v: number) => (v / 1_000_000).toLocaleString("en-US", { maximumFractionDigits: 0 });
    return `${mb(s.lo)}–${mb(s.hi)}${plus} MB`;
  }
  return `${fmtNumber(key, s.lo)}–${fmtNumber(key, s.hi)}${plus}`;
};
const videoYes = featured.filter((e) => e.accepts.video === "yes").length;
const ms = models(featured);
const upstreamOnly = entries.length - featured.length;
// Copy beside the two charts, from the same data: the hero's frames per request, and the
// most and fewest frames of one clip fed in the video block.
const of = (slug: string) => entries.filter((e) => modelSlug(e) === slug);
const heroFrames = bars("frames_768x432", of(HERO_MODEL)).filter((b) => b.value);
const [heroHi, heroLo] = [heroFrames[0], heroFrames[heroFrames.length - 1]];
const videoName = of(VIDEO_MODEL)[0]?.model.name;
const fed = bars("video_frames_per_min", of(VIDEO_MODEL)).filter((b) => b.value !== null)
  .map((b) => b.entry.limits.video_frames_per_min!.frames_per_video!);
// Small multiples share one axis.
const framesMax = niceScale(Math.max(...bars("frames_768x432").map((b) => b.value ?? 0))).max;
---
<Base>
  <section class="hero">
    <div class="hero-copy">
    <span class="eyebrow"><b>●</b> Measured {updated} · {entries.length} model × provider pairs</span>
    <h1>Every vision API has a different ceiling. <span class="dim">We measure it.</span></h1>
    <p class="lede">
      Send the same video frames to the same model, and one provider stops at {heroLo.value} while another
      {heroHi.open ? ` takes all ${heroHi.value} we sent` : ` takes ${heroHi.value}`}. vlm.fyi records what each API
      actually accepts in one request: images, real video frames, bytes and video files, with the provider's own error
      message as evidence.
    </p>
    <div class="actions">
      <a class="pill" href="#limits">See the limits</a>
      <a class="pill ghost" href="/methodology">How we measure</a>
    </div>
    </div>
    <HeroChart />
  </section>

  <div class="strip">
    <div>
      <span class="eyebrow">Pairs measured</span>
      <strong>{entries.length}</strong>
      <span class="sub">{featured.length} featured · {upstreamOnly} more OpenRouter upstreams</span>
    </div>
    <div>
      <span class="eyebrow">Images per request</span>
      <strong>{range("images_per_request")}</strong>
      <span class="sub">set by the provider, not the model</span>
    </div>
    <div>
      <span class="eyebrow">Video seen per minute</span>
      <strong>{range("video_frames_per_min")} frames</strong>
      <span class="sub">same 5-min clip, depends on the provider</span>
    </div>
    <div>
      <span class="eyebrow">Tokens per frame</span>
      <strong>{range("tokens_per_frame_768x432")}</strong>
      <span class="sub">for the same 768×432 frame</span>
    </div>
  </div>

  {videoName && fed.length > 1 && (
    <section class="block featured-model">
      <div>
        <span class="eyebrow">The routing lottery</span>
        <h2>Same model id, same clip, a different video every time.</h2>
        <p class="sub">
          OpenRouter routes one model id to many upstream providers. We pinned each one and sent the same 5-minute clip.
          This is how much of it each upstream fed {videoName}.
        </p>
      </div>
      <VideoChart />
    </section>
  )}

  <section class="block explorer" id="limits" data-scope="all" data-view="model" aria-label="Limits by metric">
    <header>
      <span class="eyebrow"><b>01</b> — Limits per request</span>
      <h2>Pick a limit. See who fits.</h2>
    </header>
    <div class="explorer-controls">
    <MetricTabs metrics={METRICS} />
    <div class="scopes">
    <div class="tabs scope" role="radiogroup" aria-label="Which pairs">
      <button type="button" role="radio" data-scope="featured" aria-checked="false">Featured</button>
      <button type="button" role="radio" data-scope="upstreams" aria-checked="false">OpenRouter upstreams</button>
      <button type="button" role="radio" data-scope="all" aria-checked="true">All {entries.length}</button>
    </div>
    <div class="tabs scope" role="radiogroup" aria-label="Arrange">
      <button type="button" role="radio" data-view="rank" aria-checked="false">Ranked</button>
      <button type="button" role="radio" data-view="model" aria-checked="true">By model</button>
    </div>
    </div>
    </div>
    {METRICS.map((m, i) => <RankedBars metric={m} hidden={i > 0} />)}
  </section>

  <section class="block">
    <header>
      <span class="eyebrow"><b>02</b> — Same model, different provider</span>
      <h2>The provider decides, not the model.</h2>
      <p class="sub">Frames per request for each provider of a model, on one shared scale, and whether that provider takes video.</p>
    </header>
    <div class="cards">
      {ms.filter((m) => m.entries.length > 1).map((m) => <ModelCard {...m} max={framesMax} />)}
    </div>
    <p class="sub more">Single-provider models: {ms.filter((m) => m.entries.length === 1).map((m, i, a) => (
      <><a href={`/models/${m.slug}`}>{m.name}</a>{i < a.length - 1 ? ", " : ""}</>
    ))}.</p>
  </section>

  <section class="block">
    <header>
      <span class="eyebrow"><b>03</b> — Request format</span>
      <h2>What each endpoint accepts.</h2>
      <p class="sub">Input types, and the request-format rules that break integrations most often.</p>
    </header>
    <CapabilityGrid />
  </section>

  <nav class="grid-cells next" aria-label="More">
    <a class="next-card" href="/table"><strong>Full table</strong><span>Every limit for every pair, sortable</span></a>
    <a class="next-card" href="/methodology"><strong>How we measure</strong><span>Synthetic probes, caps and caveats</span></a>
    <a class="next-card" href="/api"><strong>Use the data</strong><span>JSON and CSV, CC BY 4.0</span></a>
  </nav>

  <Tooltip />

  <script>
    const explorer = document.querySelector<HTMLElement>(".explorer")!;
    for (const attr of ["scope", "view"] as const) {
      document.querySelectorAll<HTMLButtonElement>(`.scope [data-${attr}]`).forEach((b, _, all) => {
        b.addEventListener("click", () => {
          explorer.dataset[attr] = b.dataset[attr]!;
          all.forEach((x) => x.setAttribute("aria-checked", String(x === b)));
        });
      });
    }
  </script>
</Base>
